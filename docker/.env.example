# Copy to docker/.env and adjust as needed (docker compose auto-loads .env).
# These are test-only defaults; never reuse them for a real deployment.

# Host port the Redmine web/REST API is published on.
REDMINE_PORT=3080

# Postgres credentials/database used by the test stack.
POSTGRES_DB=redmine
POSTGRES_USER=redmine
POSTGRES_PASSWORD=redmine

# Rails secret; override with a real random value outside of tests.
REDMINE_SECRET_KEY_BASE=please-change-me-in-real-envs
